@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<header class="page-header">
    <div>
        <p class="eyebrow">Lavandería Pepokita</p>
        <h1>Algo salió mal</h1>
    </div>
</header>

<p class="description">
    No pudimos completar lo que pediste. Vuelve al panel principal e inténtalo de nuevo.
</p>

@if (Model.ShowRequestId)
{
    <p class="description">Código de seguimiento: <code>@Model.RequestId</code></p>
}

<p><a class="primary-button" asp-controller="Home" asp-action="Index">Volver al panel principal</a></p>
