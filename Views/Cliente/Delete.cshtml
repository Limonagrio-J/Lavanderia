@model PrototipoCRUD.Models.Cliente
@{
    ViewData["Title"] = "Dar de baja cliente";
}

<h1>Dar de baja cliente</h1>
<p class="text-danger">¿Seguro que quieres dar de baja a este cliente? Sus datos se conservan en el historial.</p>

<dl class="row">
    <dt class="col-sm-3">Documento</dt><dd class="col-sm-9">@Model.Documento</dd>
    <dt class="col-sm-3">Nombre completo</dt><dd class="col-sm-9">@Model.Nombre @Model.Apellido</dd>
    <dt class="col-sm-3">Teléfono</dt><dd class="col-sm-9">@Model.Telefono</dd>
    <dt class="col-sm-3">Correo</dt><dd class="col-sm-9">@Model.Correo</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Dar de baja</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
</form>
